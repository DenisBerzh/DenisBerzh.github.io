{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": ["http://localhost/index.html", "http://localhost/resume.html", "http://localhost/en/index.html", "http://localhost/en/resume.html"],
      "numberOfRuns": 1,
      "settings": { "blockedUrlPatterns": ["*mc.yandex*"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.85 }]
      }
    }
  }
}
